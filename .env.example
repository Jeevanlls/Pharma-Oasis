# ===== Pharma Oasis — environment variables =====
# Copy to .env for local dev. On Render, set these in the dashboard.

# ---- Database (Neon Postgres) — reuse the SAME URL as production ----
NEON_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# ---- App ----
NODE_ENV=production
# PORT is set automatically by Render; only needed for local dev (defaults to 5000)
PORT=5000
SESSION_SECRET=reuse-the-same-secret-as-replit-so-logins-survive
SITE_URL=https://pharmaoasis.co.uk

# ---- OpenAI (AI agents, chat, SEO) ----
OPENAI_API_KEY=

# ---- Email (Zoho SMTP) ----
ZOHO_EMAIL=jeevan@pharmaoasis.com
ZOHO_EMAIL_PASSWORD=
NOTIFICATION_EMAIL=jeevan@pharmaoasis.com
RESEND_API_KEY=

# ---- Object storage (Cloudflare R2, S3-compatible) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=pharma-oasis-web-media
# R2_ENDPOINT is auto-derived from R2_ACCOUNT_ID; override only if needed
